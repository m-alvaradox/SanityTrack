[debug] [2026-08-15T04:14:36.138Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/sanity-track/rulesets {"name":"projects/sanity-track/rulesets/c742bcaa-4b35-49a7-b47e-0d0e42fcd679","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /bathrooms/{bathroomId} {\n      allow read: if true;\n      allow create, update: if bathroomId.matches('bathroom[0-9]+')\n        && request.resource.data.people is int\n        && request.resource.data.people >= 0\n        && request.resource.data.soap_ok is bool\n        && request.resource.data.paper_ok is bool\n        && request.resource.data.air_raw is number\n        && request.resource.data.air_raw >= 0\n        && request.resource.data.high_traffic is bool;\n      allow delete: if false;\n    }\n\n    match /readings/{readingId} {\n      allow read: if true;\n      allow create, update: if request.resource.data.bathroomId.matches('bathroom[0-9]+')\n        && request.resource.data.people is int\n        && request.resource.data.people >= 0\n        && request.resource.data.soap_ok is bool\n        && request.resource.data.paper_ok is bool\n        && request.resource.data.air_raw is number\n        && request.resource.data.air_raw >= 0\n        && request.resource.data.high_traffic is bool;\n      allow delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-15T04:14:35.849272Z","metadata":{"services":["cloud.firestore"]}}
